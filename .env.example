# Mineview binds to loopback unless you explicitly allow remote access in Settings
# and restart. HOST is ignored when it is not a loopback address unless allowRemote
# has been saved from the local Settings page.
HOST=127.0.0.1
PORT=3847

# Optional. Defaults to ./data next to the application.
# DATA_DIR=C:\Users\you\mineview-data

# Optional unattended initial password. If omitted, a password is generated in
# data/initial-password.txt on first launch. This does not override an existing password.
# MINEVIEW_INITIAL_PASSWORD=
